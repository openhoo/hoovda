{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhoo.github.io/hoovda/oracle/trace.schema.json",
  "title": "HooVDA NVDA black-box trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "source", "profile", "locale", "keyboardLayout", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "source": { "enum": ["NVDA", "HooVDA"] },
    "profile": { "const": "nvda-web-2026.1.1" },
    "locale": { "enum": ["en-US", "de-DE"] },
    "keyboardLayout": { "enum": ["desktop", "laptop"] },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "speech", "braille"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "speech": { "type": "array", "items": { "type": "string" } },
          "braille": { "type": "array", "items": { "type": "string" } },
          "mode": { "type": "string" },
          "raw": {}
        }
      }
    }
  }
}
