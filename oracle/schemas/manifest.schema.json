{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhoo.github.io/hoovda/oracle/manifest.schema.json",
  "title": "HooVDA black-box oracle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "status", "oracle", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "profile": { "const": "nvda-web-2026.1.1" },
    "status": { "enum": ["incomplete", "complete"] },
    "notes": { "type": "string" },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version", "platform", "captureToolHash"],
      "properties": {
        "product": { "const": "NVDA" },
        "version": { "const": "2026.1.1" },
        "platform": { "type": "string", "minLength": 1 },
        "captureToolHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "locale", "keyboardLayout", "fixture", "fixtureSha256", "expected", "expectedSha256", "observed", "observedSha256", "tags"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "locale": { "enum": ["en-US", "de-DE"] },
          "keyboardLayout": { "enum": ["desktop", "laptop"] },
          "fixture": { "type": "string", "minLength": 1 },
          "fixtureSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "expected": { "type": "string", "minLength": 1 },
          "expectedSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "observed": { "type": "string", "minLength": 1 },
          "observedSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "tags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  }
}
